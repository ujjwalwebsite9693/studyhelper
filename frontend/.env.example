# URL of your Render backend (no trailing slash). Once you've connected the
# custom domain, this should point at your api subdomain, e.g:
VITE_API_URL=https://api.hubstudy.online

# Your ImgBB API key, from https://api.imgbb.com/ (used for profile photo upload)
VITE_IMGBB_KEY=your_imgbb_api_key

# Google Analytics 4 Measurement ID (starts with "G-"). Get this from
# analytics.google.com after creating a property — see SEO-SETUP.md.
# Leave blank to disable analytics (e.g. in local development).
VITE_GA_ID=
