# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/sbte_portal?retryWrites=true&w=majority

# Secret used to sign login tokens (make this a long random string)
JWT_SECRET=change_this_to_a_long_random_string

# Admin login credentials (no admin signup form exists on purpose — you log in with these)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Cloudinary (free tier) — used to store PDF files (papers, notes, syllabus, etc.)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Comma separated list of frontend origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# Your own Render URL, used by the self-ping keep-alive helper.
# Leave blank while developing locally — keepalive auto-disables without it.
RENDER_EXTERNAL_URL=https://your-backend.onrender.com

PORT=5000
