# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/hub_study?retryWrites=true&w=majority

# Secret used to sign login tokens (make this a long random string)
JWT_SECRET=change_this_to_a_long_random_string

# Used ONLY once — the very first time the server starts with an empty
# database — to create the initial Super Admin account. After that, manage
# admin accounts from the in-app "Manage Admins" page instead; changing
# these env vars later has no effect. If left unset, defaults to
# username "Ujjwal Mehta" / password "Ujjwal@9512".
ADMIN_USERNAME=Ujjwal Mehta
ADMIN_PASSWORD=Ujjwal@9512

# Cloudinary (free tier) — used to store PDF files (papers, notes, syllabus, etc.)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Comma separated list of frontend origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173,https://hubstudy.online,https://www.hubstudy.online,https://your-project.vercel.app

# Your own Render URL, used by the self-ping keep-alive helper.
# Leave blank while developing locally — keepalive auto-disables without it.
RENDER_EXTERNAL_URL=https://your-backend.onrender.com

PORT=5000
